{
  "name": "dsh-prompt-craft",
  "version": "0.1.0",
  "description": "A second composer button for DeepSeek Harness: rewrite a rough draft into a task brief for a tool-using agent (outcome, boundaries, checkable done, explicit assumptions). Coexists with dsh-prompt-enhance; uninstall it and nothing else changes.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.2 <0.3.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["react-dom"],
      "platform": "web"
    }
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "author": "JEYOO-YU",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JEYOO-YU/dsh-prompt-craft.git"
  },
  "homepage": "https://github.com/JEYOO-YU/dsh-prompt-craft#readme",
  "bugs": {
    "url": "https://github.com/JEYOO-YU/dsh-prompt-craft/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "prompt"
  ]
}
